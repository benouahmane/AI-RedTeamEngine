# Database
DATABASE_URL=postgresql+psycopg://redteam:redteam@localhost:5432/redteam_engine

# LLM provider — "anthropic" or "openrouter"
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
# Optional model routing: a stronger model plans/decides, a cheaper one parses.
# Leave unset to use ANTHROPIC_MODEL for both.
# ANTHROPIC_PLANNER_MODEL=claude-opus-4-8
# ANTHROPIC_PARSER_MODEL=claude-haiku-4-5-20251001

# OpenRouter (only if LLM_PROVIDER=openrouter) — one key, many vendors.
# Intended for cross-model benchmark runs; keep LLM_PROVIDER=anthropic for the
# runs that produce assessment reports.
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=qwen/qwen3.8-max
# Set to true if the model needs an explicit cache breakpoint on the system
# prompt. The ~35k-char tool catalogue is re-sent every step, so whether
# caching engages is the single biggest cost factor in a session.
OPENROUTER_CACHE_SYSTEM=false
# Set to true if the model returns prose around its JSON and steps start
# failing with "LLM returned malformed JSON".
OPENROUTER_JSON_MODE=false

# Metasploit RPC
MSF_RPC_HOST=127.0.0.1
MSF_RPC_PORT=55553
MSF_RPC_USER=msf
MSF_RPC_PASS=changeme

# OpenVAS / Greenbone (gvm)
GVM_CONNECTION=tls
GVM_HOST=127.0.0.1
GVM_PORT=9390
GVM_SOCKET_PATH=/run/gvmd/gvmd.sock
GVM_USERNAME=admin
GVM_PASSWORD=admin

# Neo4j (BloodHound graph queries — see docker-compose.yml)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=bloodhoundpass

# CALDERA adversary-emulation server (REST API)
CALDERA_URL=http://127.0.0.1:8888
CALDERA_API_KEY=ADMIN123

# Engine behaviour
DEFAULT_MODE=human_in_loop      # autonomous | human_in_loop
MAX_AGENT_STEPS=200
TOOL_EXECUTION_TIMEOUT_SEC=900

# Transient tool-failure handling
TOOL_RETRY_ATTEMPTS=1           # extra attempts after the first
TOOL_RETRY_BACKOFF_SEC=3.0

# Concurrent multi-host runs (run-range): per-host step budget
MAX_STEPS_PER_HOST=60

# Lab safety — comma-separated CIDR ranges the agent is allowed to touch.
# env1 = Metasploitable/classic, env2 = VulnHub, env3 = GOAD AD.
ALLOWED_TARGET_RANGES=192.168.56.0/24,10.10.0.0/16,10.20.0.0/16
